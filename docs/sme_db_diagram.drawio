        <!-- ASSESSMENTS -->
        <mxCell id="assessments" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" value="&#xa;assessments&#xa;─────────────&#xa;PK id&#xa;FK sme_id → sme_profiles&#xa;FK template_id → templates&#xa;FK program_id → programs&#xa;total_score&#xa;status" vertex="1">
