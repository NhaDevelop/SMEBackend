        <mxCell id="investor_interests" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" value="&#xa;investor_interests&#xa;─────────────&#xa;PK id&#xa;FK investor_id → investor_profiles&#xa;FK sme_id → sme_profiles&#xa;notes" vertex="1">
          <mxGeometry height="110" width="260" x="1250" y="800" as="geometry" />
