<mxfile host="app.diagrams.net">
  <diagram name="Full SME DB Schema" id="0">
    <mxGraphModel dx="2000" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="3300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- CORE AUTH & PROFILES -->
        <mxCell id="users" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&#xa;users&#xa;─────────────&#xa;PK id&#xa;name&#xa;email&#xa;role (SME/INVESTOR/ADMIN)&#xa;status&#xa;is_verified" vertex="1">
          <mxGeometry height="150" width="260" x="800" y="100" as="geometry" />
        </mxCell>

        <mxCell id="sme_profiles" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" value="&#xa;sme_profiles&#xa;─────────────&#xa;PK id&#xa;FK user_id → users&#xa;company_name&#xa;readiness_score&#xa;risk_level" vertex="1">
          <mxGeometry height="130" width="260" x="400" y="300" as="geometry" />
        </mxCell>

        <mxCell id="investor_profiles" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" value="&#xa;investor_profiles&#xa;─────────────&#xa;PK id&#xa;FK user_id → users&#xa;organization_name&#xa;investor_type" vertex="1">
          <mxGeometry height="110" width="260" x="1200" y="300" as="geometry" />
        </mxCell>

        <!-- COMMUNICATION & LOGS -->
        <mxCell id="messages" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&#xa;messages&#xa;─────────────&#xa;PK id&#xa;FK sender_id → users&#xa;FK receiver_id → users&#xa;chat_id&#xa;content" vertex="1">
          <mxGeometry height="130" width="260" x="300" y="50" as="geometry" />
        </mxCell>

        <mxCell id="notifications" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&#xa;notifications&#xa;─────────────&#xa;PK id&#xa;FK user_id → users&#xa;type&#xa;message&#xa;is_read" vertex="1">
          <mxGeometry height="130" width="260" x="1300" y="50" as="geometry" />
        </mxCell>

        <mxCell id="verification_requests" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" value="&#xa;verification_requests&#xa;─────────────&#xa;PK id&#xa;FK user_id → users&#xa;document_type&#xa;status" vertex="1">
          <mxGeometry height="110" width="260" x="600" y="-100" as="geometry" />
        </mxCell>

        <mxCell id="audit_logs" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" value="&#xa;audit_logs&#xa;─────────────&#xa;PK id&#xa;FK user_id → users&#xa;action&#xa;target_entity" vertex="1">
          <mxGeometry height="110" width="260" x="1000" y="-100" as="geometry" />
        </mxCell>

        <!-- FRAMEWORK & TEMPLATES -->
