        <mxCell id="sectors" parent="1" style="shape=table;startSize=30;container=0;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;" value="&#xa;sectors&#xa;─────────────&#xa;PK id&#xa;name&#xa;color" vertex="1">
